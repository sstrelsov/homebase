#!/usr/bin/env bash
# Stage, preview and publish Stached puzzles: `scripts/stached help` (the CLI
# is stached-api/cli.ts). It runs where the puzzles live, with the API's
# settings: on the Studio, right there; anywhere else, on the Studio over SSH,
# sending a puzzle file to stage along. STACHED_ENV points it at another
# settings file instead, such as a `make phone` run's .phone/api.env.
set -euo pipefail
env_file="${STACHED_ENV:-$HOME/.config/stached/api.env}"
if [ -f "$env_file" ]; then
  env_file="$(cd "$(dirname "$env_file")" && pwd)/$(basename "$env_file")"
  cd "$(dirname "$0")/.."
  exec bun --env-file="$env_file" stached-api/cli.ts "$@"
fi
if [ -n "${STACHED_ENV:-}" ]; then
  echo "stached: no $STACHED_ENV" >&2
  exit 1
fi

remote() { ssh -o BatchMode=yes personal-studio "~/dev/homebase/scripts/stached $(printf '%q ' "$@")"; }
if [ "${1:-}" = stage ] && [ -f "${2:-}" ]; then
  remote stage - <"$2"
else
  remote "$@"
fi
