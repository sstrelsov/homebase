# Copy to .env and fill in. Values here are baked into the client bundle at
# build time — only use keys that are safe to expose publicly.

# CARTO basemaps API key for the Brooklyn Heights map. Free, no account
# needed: https://carto.com/basemaps/apikey (key arrives by email; if it
# doesn't, write to support-basemaps@carto.com). Optional — without it the
# map falls back to Esri's keyless dark tiles, which are a bit softer when
# zoomed in close.
VITE_CARTO_API_KEY=
